{
  "manifest_version": 3,
  "name": "DSH Web Sensor - 知识采集与预处理",
  "version": "1.0.0",
  "description": "DSH (DeepSeek Harness) 个人文献与知识智能体前端多模态数据采集与预处理插件",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开 DSH 调研工作台"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-8kDxB8f1.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "sidePanel",
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/index.ts-8kDxB8f1.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
